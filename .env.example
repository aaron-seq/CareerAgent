# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Cloud LLM fallback (optional) - free tier at https://console.groq.com/keys
# PRIVACY: prompts sent here leave your machine. Prefer local Ollama for
# resume/CV work; see the PII guardrail in CLAUDE.md.
GROQ_API_KEY=

# Gmail API Credentials (Optional - for Gmail draft creation)
# Download credentials.json from Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Job board / aggregator APIs
# Keyless, nothing to set here (verified live 2026-08-27): Remotive, Arbeitnow,
# Jobicy, RemoteOK, Himalayas, plus every company-board ATS (Greenhouse, Lever,
# Ashby, SmartRecruiters, Recruitee, Workable).
# Only these two aggregators take credentials:
#   Adzuna - required; free key at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
#   The Muse - optional; works keyless at a lower rate limit.
#   Free key at https://www.themuse.com/developers/api/v2
THEMUSE_API_KEY=

# Application Settings
APP_PORT=8501
DEBUG_MODE=false

# Storage Configuration
STORAGE_PATH=careeragent_data

# DuckDuckGo Search Settings
SEARCH_MAX_RESULTS=20
SEARCH_REGION=wt-wt

# LLM Generation Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120

# Draft Quality Thresholds
MAX_EMAIL_WORDS=180
MIN_QUALITY_SCORE=70
